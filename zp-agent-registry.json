      "configuration": {
        "status": "future",
        "label": "CONFIGURACIÓN",
        "selectionFeedback": "CONFIGURACIÓN · PRÓXIMAMENTE"
      }
    }
  },
  "controls": {
    "Lx": {
      "label": "Lx",
      "role": "master-left-sample-in-and-pattern-navigation",
      "owner": "creator.ui",
      "input": "pointer-rotation",
      "behavior": "Control maestro izquierdo. En Sample ajusta IN mediante creator.sample.trim.set target=start; en Pattern/Piano actúa como navegación contextual. No existe un encoder IN adicional.",
      "stepDegrees": 14,
      "wrap": true,
      "commands": [
        "creator.sample.trim.set"
      ],
      "contextEvent": "focusin",
      "mount": ".mid>.lx",
      "placement": "left-side-rail",
      "adaptive": true,
      "activation": {
        "trigger": [
          "pattern-selected",
          "pattern-edit-open",
          "piano-roll-open"
        ],
        "default": "sample-in",
        "deactivateOn": "editor-close"
      },
      "master": true,
      "sampleMapping": {
        "label": "IN",
        "command": "creator.sample.trim.set",
        "payload": {
          "target": "start",
          "position": "number",
          "commit": "boolean"
        }
      }
    },
    "Rx": {
      "label": "Rx",
      "role": "master-right-output",
      "owner": "creator.ui+creator-engine.html",
      "input": "pointer-rotation",
      "behavior": "Control maestro derecho. En Sample ajusta OUT mediante creator.sample.trim.set target=end; en otros contextos controla el parámetro contextual o PUSH ENTER.",
      "existingSelector": ".pe",
      "commands": [
        "creator.sample.trim.set",
        "creator.control.set"
      ],
      "mount": ".mid>.rx",
      "placement": "right-side-rail",
      "adaptive": true,
      "scrollFallback": {
        "enabled": true,
        "source": "window.__zpLxTarget",
        "axisPriority": [
          "y",
          "x"
        ],
        "step": "proportional-to-rotation",
        "disabledWhen": [
          "trim.active",
          "midi.freeMove",
          "selected-target-is-trim-or-midi"
        ]
      },
      "master": true,
      "sampleMapping": {
        "label": "OUT",
        "command": "creator.sample.trim.set",
        "payload": {
          "target": "end",
          "position": "number",
          "commit": "boolean"
        }
      }
    }
  },
  "layout": {
    "encoderPlacement": "sides",
    "behavior": "adaptive",
    "spacing": "compact",
    "mount": {
      "Lx": ".mid>.lx",
      "Rx": ".mid>.rx"
    },
    "responsiveSizes": {
      "default": "50px",
      "narrow": "46px",
      "shortViewport": "42px"
    },
    "notes": "Lx/Rx se montan como controles maestros dentro de .mid y ocupan raíles laterales del módulo. Al abrir Piano Roll, la GUI los reubica temporalmente en el dock inferior; el bridge y el estado del motor permanecen independientes.",
    "contextualControls": {
      "IN": {
        "context": "sample",
        "control": "Lx",
        "position": "left-master-rail",
        "independent": false
      },
      "Lx": {
        "context": "pattern-edit-or-piano-roll",
        "position": "left-master-rail",
        "default": "inactive"
      },
      "Rx": {
        "context": "sample-out-and-contextual-master",
        "position": "right-master-rail"
      },
      "SHIFT": "preserved"
    }
  },
  "trimControl": {
    "version": "1.0.0",
    "phases": {
      "1": {
        "name": "select",
        "label": "Selección IN/OUT",
        "color": "#A5E8B0",
        "touch": "single-target",
        "encoder": {
          "Lx": "navigation",
          "Rx": "selected-target-adjust"
        },
        "description": "Un marcador activo por vez; la selección se refleja en waveform y LCD."
      },
      "2": {
        "name": "multitouch",
        "label": "Touch libre",
        "color": "#E9A044",
        "touch": "dual-independent",
        "encoder": {
          "Lx": "navigation",
          "Rx": "context-scroll"
        },
        "description": "IN y OUT pueden moverse simultáneamente con dos punteros táctiles independientes."
      },
      "3": {
        "name": "encoder",
        "label": "Control Lx/Rx",
        "color": "#E53935",
        "touch": "locked",
        "encoder": {
          "Lx": "trim.start",
          "Rx": "trim.end"
        },
        "description": "Touch bloqueado; Lx controla IN y Rx controla OUT directamente."
      }
    },
    "cycle": [
      1,
      2,
      3
    ],
    "stateOwner": "creator.ui",
    "valueOwner": "creator-engine.html",
    "command": "creator.sample.trim.set",
    "persistence": "commit:true",
    "led": "trim-phase-led"
  },
