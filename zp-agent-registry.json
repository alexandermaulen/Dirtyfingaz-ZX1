{
  "version": "1.0.0",
  "app": "DIRTYFINGAZ ZX1",
  "architecture": {
    "gui": {
      "file": "index.html",
      "owner": "Interacción, controles, feedback visual, navegación, contexto seleccionado."
    },
    "engine": {
      "file": "creator-engine.html",
      "owner": "AudioContext, AudioBuffer, scheduler, parámetros efectivos, estado musical y persistencia."
    },
    "bridge": {
      "protocolVersion": 1,
      "owner": "Mensajes GUI↔motor con source, requestId, ACK/error y timeout."
    },
    "storage": {
      "file": "zp-storage.js",
      "owner": "IndexedDB y aislamiento por proyecto."
    },
    "worker": {
      "status": "not present in the current repository; excluded from this implementation phase",
      "owner": "No worker module is assumed or invoked."
    },
    "serviceWorker": {
      "status": "not present in the current repository; excluded from this implementation phase",
      "owner": "No service worker or offline cache is assumed."
    },
    "rules": [
      "No duplicar estado autoritativo del motor en GUI.",
      "No ejecutar código arbitrario desde el agente.",
      "Separar propuesta, validación, aplicación y confirmación.",
      "Los cambios que crucen GUI y motor requieren contrato y pruebas de ambos lados.",
      "El usuario autorizó explícitamente la edición directa de GitHub, la validación, la integración y el despliegue de DIRTYFINGAZ ZX1."
    ]
  },
  "parameters": [
    {
      "key": "master",
      "label": "Volumen maestro",
      "module": "Master / Mixer",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.75,
      "command": "creator.control.set",
      "payload": {
        "name": "master",
        "value": "$value"
      },
      "unit": "linear",
      "description": "Ganancia maestra del motor."
    },
    {
      "key": "fx-amount",
      "label": "Cantidad FX",
      "module": "FX",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.25,
      "command": "creator.control.set",
      "payload": {
        "name": "fx-amount",
        "value": "$value"
      },
      "unit": "normalized",
      "description": "Cantidad global del bloque FX."
    },
    {
      "key": "trim.start",
      "label": "Sample IN",
      "module": "Sample Editor",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.00005,
      "default": 0,
      "command": "creator.sample.trim.set",
      "payload": {
        "target": "start",
        "position": "$value",
        "commit": true
      },
      "unit": "normalized",
      "description": "Punto inicial del sample. Debe permanecer antes de OUT."
    },
    {
      "key": "trim.end",
      "label": "Sample OUT",
      "module": "Sample Editor",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.00005,
      "default": 1,
      "command": "creator.sample.trim.set",
      "payload": {
        "target": "end",
        "position": "$value",
        "commit": true
      },
      "unit": "normalized",
      "description": "Punto final del sample. Debe permanecer después de IN."
    },
    {
      "key": "midi.step",
      "label": "MIDI Step",
      "module": "Piano Roll",
      "owner": "engine",
      "type": "integer",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 0,
      "command": null,
      "description": "Posición de nota dentro del patrón. Requiere selección de nota y API MIDI dedicada."
    },
    {
      "key": "midi.pitch",
      "label": "MIDI Pitch",
      "module": "Piano Roll",
      "owner": "engine",
      "type": "integer",
      "min": 0,
      "max": 127,
      "step": 1,
      "default": 60,
      "command": null,
      "description": "Altura MIDI de la nota seleccionada."
    },
    {
      "key": "midi.length",
      "label": "MIDI Length",
      "module": "Piano Roll",
      "owner": "engine",
      "type": "integer",
      "min": 1,
      "max": 16,
      "step": 1,
      "default": 1,
      "command": null,
      "description": "Duración de nota en pasos."
    },
    {
      "key": "midi.velocity",
      "label": "MIDI Velocity",
      "module": "Piano Roll",
      "owner": "engine",
      "type": "integer",
      "min": 1,
      "max": 127,
      "step": 1,
      "default": 100,
      "command": null,
      "description": "Velocidad MIDI de la nota seleccionada."
    },
    {
      "key": "attack",
      "label": "Attack",
      "module": "Sample Envelope",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.004502251125562782,
      "command": "creator.control.set",
      "payload": {
        "name": "attack",
        "value": "$value"
      },
      "unit": "normalized",
      "description": "Attack por PAD, guardado dentro del proyecto."
    },
    {
      "key": "decay",
      "label": "Decay",
      "module": "Sample Envelope",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.05843071786310517,
      "command": "creator.control.set",
      "payload": {
        "name": "decay",
        "value": "$value"
      },
      "unit": "normalized",
      "description": "Decay por PAD, guardado dentro del proyecto."
    },
    {
      "key": "release",
      "label": "Release",
      "module": "Sample Envelope",
      "owner": "engine",
      "type": "range",
      "min": 0,
      "max": 1,
      "step": 0.001,
      "default": 0.04881101376720901,
      "command": "creator.control.set",
      "payload": {
        "name": "release",
        "value": "$value"
      },
      "unit": "normalized",
      "description": "Release por PAD, guardado dentro del proyecto."
    }
  ],
  "developerTemplates": [
    "json",
    "gui",
    "bridge",
    "engine",
    "test"
  ],
  "workflow": [
    "Inspectar control y leer contexto observado.",
    "Resolver parámetro en este registro JSON.",
    "Consultar backend con módulo, valor, proyecto y contrato.",
    "Generar propuesta o snippet, nunca ejecutar eval.",
    "Validar allowlist y precondiciones.",
    "Aplicar sólo parámetros live con comando explícito y ACK del motor.",
    "Para código, copiar/exportar el snippet y preparar cambios separados GUI/engine/validator."
  ],
  "project": {
    "name": "DIRTYFINGAZ ZX1",
    "repository": "https://github.com/alexandermaulen/Dirtyfingaz-ZP",
    "developmentBranch": "main",
    "pullRequest": "https://github.com/alexandermaulen/Dirtyfingaz-ZP/pull/6",
    "preview": "https://feat-dirtyfingaz-zx1-clean-integration-dirtyfingaz-zx1.alexandermaulen.workers.dev",
    "architecture": {
      "gui": "creator.html: controls, interaction, visual state and context.",
      "engine": "creator-engine.html: Web Audio, buffers, scheduler, FX, MIDI and authoritative state.",
      "bridge": "Versioned GUI-engine messages with protocolVersion, requestId, ACK/error and timeout.",
      "storage": "zp-storage.js: IndexedDB and per-project sample isolation.",
      "worker": "radio-worker.mjs: agent API and Radio Grid.",
      "agent": "zp-agent.js: contextual inspector, allowlisted parameter application and code snippet composer.",
      "registry": "zp-agent-registry.json: parameter schemas, ranges, commands and ownership.",
      "validator": "scripts/validate.mjs: static syntax and integration contracts."
    },
    "handoff": {
      "branchPolicy": "El usuario autorizó explícitamente editar GitHub, validar, fusionar y desplegar los cambios de DIRTYFINGAZ ZX1. Mantener commits trazables y no tocar producción hasta validar Preview.",
      "parallelTracks": "Keep GUI and engine work coordinated. Define bridge contract before cross-layer changes.",
      "knownFeatures": [
        "9 pads x 16 steps sequencer",
        "Piano Roll with MIDI editing and microtiming",
        "IN/OUT trim with fine PUSH ENTER and persistence",
        "Multi-project IndexedDB storage",
        "WAV/MP3 export components",
        "Cloudflare Radio Grid"
      ],
      "supabase": "Proyecto conectado y activo, pero sin tablas, migraciones ni Edge Functions. Creator mantiene IndexedDB como persistencia local; no inventar sincronización remota hasta cerrar identidad, ownership, RLS y contrato de proyectos.",
      "currentFeature": "Creator: Lx=IN, Rx=OUT en Sample; CTRL 1/2/3 controlan Attack/Decay/Release por PAD; Utility alterna ADR/ADSR y ambos estados se guardan en el proyecto.",
      "pending": [
        "Validar CI sobre el SHA actual",
        "Probar IN/OUT con Lx/Rx y persistencia de trim",
        "Probar ADR/ADSR por PAD y persistencia por proyecto",
        "Probar navegación PROJECT, patrones y Piano Roll en Safari iOS",
        "Verificar PWA offline y sincronización futura con Supabase"
      ]
    },
    "menu": {
      "entries": [
        "PROJECT MANAGER",
        "SYSTEM",
        "D BEAM SETTING",
        "MIDI UTILITY",
        "USB AUDIO/MIDI",
        "USB MASS STORAGE",
        "MASTER LEVEL",
        "CAMBIAR TEMA",
        "CONFIGURACIÓN"
      ],
      "theme": {
        "status": "implemented",
        "storageKey": "dirtyfingaz-zx1-theme",
        "options": [
